    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
